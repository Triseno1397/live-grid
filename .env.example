# Live Grid — environment variables
# Copy to .env.local and fill in. .env.local is gitignored; never commit real keys.

# --- Supabase (Project Settings -> API) ---
# Project URL, e.g. https://abcdefghijklmnop.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# "Publishable key" (newer projects) or "anon public" key (older projects).
# Safe to expose in the browser — it is bound by Row Level Security.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# "Secret key" (newer projects) or "service_role" key (older projects).
# SERVER ONLY. Bypasses RLS entirely. Never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# --- /admin/import gate ---
# Shared secret required by POST /api/admin/import via the x-admin-token header.
# Generate one: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_IMPORT_TOKEN=

# --- Expert assistant (/chat) ---
# Anthropic API key. SERVER ONLY. Without it, /chat renders a "not configured" notice and
# POST /api/chat returns 503 rather than failing at request time.
# Get one: console.anthropic.com -> API Keys
ANTHROPIC_API_KEY=

# Messages per IP per UTC day before /api/chat returns 429. Defaults to 40.
# This is the only spend limit on the endpoint — do not remove it in production.
CHAT_DAILY_LIMIT=40

# --- Supabase CLI only (not read by the app) ---
# Used for: npx supabase link / db push / gen types
# Access token: supabase.com -> Account -> Access Tokens
SUPABASE_ACCESS_TOKEN=
# The database password you set when creating the project
SUPABASE_DB_PASSWORD=
# Project ref (the subdomain in your project URL)
SUPABASE_PROJECT_REF=
